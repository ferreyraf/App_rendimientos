#!/bin/sh
# Punto de entrada del AppImage de @APP_NAME@ @VERSION@.
#   ./Bitacora.AppImage                 abre la app
#   ./Bitacora.AppImage --instalar      la instala para este usuario
#   ./Bitacora.AppImage --desinstalar   la desinstala (agregá --borrar-datos para borrar también tus datos)
#   ./Bitacora.AppImage --version
HERE="$(dirname "$(readlink -f "$0")")"

case "$1" in
  --instalar) exec "$HERE/instalar.sh" ;;
  --desinstalar) shift; exec "$HERE/desinstalar.sh" "$@" ;;
  --version) echo "@APP_NAME@ @VERSION@"; exit 0 ;;
esac

exec "$HERE/usr/lib/@APP_ID@/@APP_ID@" "$@"
